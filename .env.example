# Supabase — Project Settings → API
# A anon/publishable key é usada só no servidor, para leituras (RLS somente-select).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key: SOMENTE servidor. Nunca use em código "use client".
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — sobrescreve a URL base da API (não oficial) de Pro Clubs da EA.
# Padrão: https://proclubs.ea.com/api/fc
EA_API_BASE_URL=

# Opcional — protege /api/cron/sync (Vercel Cron). Mínimo de 16 caracteres.
# Gere com: openssl rand -hex 32
CRON_SECRET=

# Opcional — URL pública do site, usada nas prévias de link (WhatsApp etc.).
# Na Vercel não precisa: o domínio de produção é detectado automaticamente.
NEXT_PUBLIC_SITE_URL=
