# Supabase — Project Settings → API
# A anon/publishable key é usada só no servidor, para leituras (RLS somente-select).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key: SOMENTE servidor. Nunca use em código "use client".
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — sobrescreve a URL base da API (não oficial) de Pro Clubs da EA.
# Padrão: https://proclubs.ea.com/api/fc
EA_API_BASE_URL=

# Opcional (produção na Vercel) — a EA bloqueia os IPs da Vercel, então o botão
# "Atualizar" pede a sincronização ao GitHub Actions. Token fine-grained com
# acesso só a este repositório e permissão "Actions: Read and write".
# O repositório é detectado na Vercel; fora dela, defina GITHUB_REPOSITORY=dono/repo.
GITHUB_DISPATCH_TOKEN=

# Opcional — URL pública do site, usada nas prévias de link (WhatsApp etc.).
# Na Vercel não precisa: o domínio de produção é detectado automaticamente.
NEXT_PUBLIC_SITE_URL=
